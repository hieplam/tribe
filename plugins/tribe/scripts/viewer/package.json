{
  "name": "tribe-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only local transcript viewer for Claude Code sessions (reads ~/.claude/projects; campaign badges from two files under ~/.tribe; zero writes at runtime)",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit && bun test",
    "check:client": "tsc -p tsconfig.client.json --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "react": "~19.2.0",
    "react-dom": "~19.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}